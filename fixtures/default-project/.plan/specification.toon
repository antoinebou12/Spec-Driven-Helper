          value: "[[\"p95 < 300 ms at 50 req/s\",\"Load test\",\"k6\",\"Before each release\"],[\"99.5% availability\",\"SLO monitoring\",\"Prometheus\",\"Continuous\"],[\"WCAG 2.2 AA\",\"Automated and manual audit\",\"axe, NVDA\",\"Each release\"]]"
          state: answered
