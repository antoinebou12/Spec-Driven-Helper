    - id: REQ-001
      type: requirement
      title: Customers submit a request with up to 5 attachments
      body: ""
      status: accepted
      acceptance: "Given a signed-in customer, when they submit a valid request, then it receives an ID within 2 seconds."
      priority: must
      owner: ""
      needsReview: false
    - id: REQ-002
      type: requirement
      title: Customers see only their organization’s requests
      body: ""
      status: accepted
      acceptance: "Given a customer of organization A, when they request a record of organization B, then the API returns 404 and audits the attempt."
      priority: must
      owner: ""
      needsReview: false
