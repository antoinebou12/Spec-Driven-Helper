          value: "[[\"Modular monolith\",\"Simple deploys, one codebase\",\"Coarse scaling\",\"Chosen (ADR-001)\"],[\"Microservices\",\"Independent scaling\",\"Operational overhead for a team of 3\",\"Rejected\"]]"
