          value: "Audit role changes, exports, denied cross-organization access and settings changes with actor, time and target; keep 1 year."
          state: answered
          reason: ""
        security.8:
          value: "Customers in Québec and Ontario: Québec Law 25 and PIPEDA likely apply. Privacy officer confirms and completes a privacy impact assessment by week 4."
          state: answered
          reason: ""
        security.11:
          value: "[\"Session cookie (HttpOnly, Secure)\",\"SameSite=Lax or Strict\",\"CSRF protection\",\"Preferences in local storage\",\"No third-party cookies\"]"
          state: answered
