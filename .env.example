HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed to make state-changing requests.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# First Owner account; only used while no user exists.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
DATABASE_URL=postgresql://sdd:sdd-local-development@127.0.0.1:5433/sdd_studio
POSTGRES_PASSWORD=sdd-local-development

# Single sign-on. Company SSO (any OpenID Connect provider) and Google both follow the
# registration setting: without an invitation, new SSO accounts wait for an administrator.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local AI (Ollama). Check the connection with `pnpm ollama:check` or Administration → Local AI.
OLLAMA_URL=http://127.0.0.1:11434
# Context window requested per run (tokens, capped by the model's own window). Default 8192.
OLLAMA_NUM_CTX=
# Longest answer a local model may write (tokens). Default 2048.
OLLAMA_NUM_PREDICT=
# Local models are slow on CPU; their runs get this timeout (ms). Default 600000.
OLLAMA_RUN_TIMEOUT_MS=

# NVIDIA NIM. The free hosted endpoint (https://integrate.api.nvidia.com/v1) needs only a key from
# build.nvidia.com, entered in Settings → AI providers. Set NIM_BASE_URL to use your own NIM server
# instead (no key needed); inside Docker use http://host.docker.internal:8000/v1 or a service name.
# Check either with `NVIDIA_API_KEY=nvapi-… pnpm nim:check` (the key is read from the environment only for this check).
NIM_BASE_URL=

# Docker Compose only (see compose.yaml).
# COMPOSE_PROFILES=ollama,pdf
# Where containers reach Ollama. Default: Ollama on the Docker host. With the ollama profile: http://ollama:11434
COMPOSE_OLLAMA_URL=
# Models pulled by the ollama profile.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
APP_PORT=3001
COMPOSE_APP_ORIGIN=http://localhost:3001

# Optional isolated worker endpoint. Never point at an unrestricted shell service.
AGENT_RUNNER_URL=
AGENT_RUNNER_TOKEN=
# Isolated PDF rendering. With the pdf profile: PUBLISHER_URL=http://publisher:3200 and a random token.
PUBLISHER_URL=
PUBLISHER_TOKEN=
MCP_ALLOWED_ORIGINS=
# MCP requests per minute per client address (default 120).
MCP_RATE_LIMIT_MAX=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sdd-studio
# Observability (compose.observability.yaml): token Prometheus sends to /api/metrics, Grafana admin
# password, and the links shown on the admin page. Generate the token like ENCRYPTION_KEY.
METRICS_TOKEN=
# Requests per minute per client address (default 300). Raise it behind a proxy that shares one address.
RATE_LIMIT_MAX=
# AI optimisation: set to false to block known AI crawlers (GPTBot, ClaudeBot, …) in robots.txt.
AIO_ALLOW_AI_CRAWLERS=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_URL=
PROMETHEUS_URL=
NETDATA_URL=
TRACES_URL=
