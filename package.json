{
  "name": "sdd-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"tsx watch apps/api/src/index.ts\" \"vite --host 127.0.0.1\" \"tsx watch apps/api/src/worker.ts\"",
    "build": "tsc --noEmit && vite build && tsx scripts/build-docs-site.ts",
    "start": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ollama:check": "tsx scripts/check-ollama.ts",
    "nim:check": "tsx scripts/check-nim.ts",
    "skills:check": "tsx scripts/check-skills.ts",
    "smoke:web": "tsx scripts/smoke-web-image.ts",
    "test:coverage:web": "vitest run --config vitest.web.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:stories": "tsx scripts/check-stories-a11y.ts storybook-static",
    "e2e:server": "concurrently -k -n api,web,worker \"tsx apps/api/src/index.ts\" \"vite --host 127.0.0.1\" \"tsx apps/api/src/worker.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "precommit": "sh .githooks/pre-commit",
    "budgets": "tsx scripts/check-budgets.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "arch:graph": "tsx scripts/export-architecture-graph.ts",
    "ci:local": "act push -j checks",
    "ci:local:list": "act -l",
    "ci:local:all": "act push",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "lighthouse:lhci": "lhci autorun",
    "icons": "tsx scripts/generate-icons.ts",
    "grafana:dashboard": "tsx scripts/generate-grafana-dashboard.ts",
    "perf": "tsx scripts/perf.ts",
    "docs:site": "tsx scripts/build-docs-site.ts",
    "helm:check": "tsx scripts/helm-check.ts",
    "k8s:test": "tsx scripts/k8s-integration.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "fixtures:check": "tsx scripts/generate-fixtures.ts --check",
    "plan:tasks": "tsx scripts/plan-task-docs.ts",
    "plan:tasks:check": "tsx scripts/plan-task-docs.ts --check",
    "openspec:check": "tsx scripts/check-openspec.ts",
    "ux:setup": "node scripts/ux/py.mjs setup",
    "ux:test": "node scripts/ux/py.mjs -m unittest discover -s tests/python -v",
    "ux:images": "node scripts/ux/py.mjs scripts/ux/image_tools.py",
    "ux:review": "playwright test ux-tour && node scripts/ux/py.mjs scripts/ux/review.py"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@copilotkit/react-core": "^1.75.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@openuidev/react-lang": "^0.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@toon-format/toon": "^2.0.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "fastify": "^5.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "^11.12.0",
    "monaco-editor": "^0.55.1",
    "motion": "^13.4.4",
    "openid-client": "^6.8.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "rxjs": "7.8.1",
    "simple-icons": "^16.32.0",
    "tailwind-merge": "^3.3.1",
    "unified": "11.0.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@fission-ai/openspec": "1.14.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "archunit": "^2.5.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
